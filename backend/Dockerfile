# ============================================================
# Novel Archive Backend
# Spring Boot アプリケーション用Dockerfile
# ============================================================


# ============================================================
# Build Stage
# Spring Bootアプリケーションをビルドする
# ============================================================

FROM eclipse-temurin:21-jdk AS build

# コンテナ内の作業ディレクトリ
WORKDIR /app


# ------------------------------------------------------------
# Gradle Wrapperおよび依存関係定義を先にコピー
#
# ソースコードのみ変更した場合でも、
# Gradle関連ファイルが変更されていなければ
# DockerのBuild Cacheを利用できるようにする。
# ------------------------------------------------------------

COPY gradlew .
COPY gradle ./gradle
COPY build.gradle.kts .
COPY settings.gradle.kts .

# Linux上でGradle Wrapperを実行できるようにする
RUN chmod +x gradlew


# ------------------------------------------------------------
# Gradle依存関係を事前取得
#
# この処理はbuild.gradle.kts等が変更されない限り
# Docker Cacheが利用される。
# ------------------------------------------------------------

RUN ./gradlew dependencies --no-daemon


# ------------------------------------------------------------
# アプリケーションソースをコピー
# ------------------------------------------------------------

COPY src ./src


# ------------------------------------------------------------
# Spring Boot実行Jarを作成
# ------------------------------------------------------------

RUN ./gradlew bootJar --no-daemon


# ============================================================
# Runtime Stage
# ビルド済みJarのみを使用してアプリケーションを実行する
# ============================================================

FROM eclipse-temurin:21-jre

# コンテナ内の実行ディレクトリ
WORKDIR /app


# Build Stageで作成したJarをコピー
COPY --from=build /app/build/libs/*.jar app.jar


# Spring Bootの待受ポート
EXPOSE 8080


# コンテナ起動時にSpring Bootアプリケーションを起動
ENTRYPOINT ["java", "-jar", "app.jar"]