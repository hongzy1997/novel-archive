# ============================================================
# Novel Archive Frontend
# Reactアプリケーション用Dockerfile
# ============================================================


# ============================================================
# Build Stage
# ReactアプリケーションをBuildする
# ============================================================

FROM node:22-alpine AS build

# コンテナ内の作業ディレクトリ
WORKDIR /app


# ------------------------------------------------------------
# npm依存関係定義を先にコピー
#
# Reactソースコードのみ変更した場合でも、
# package.json / package-lock.jsonが変更されていなければ
# npm install処理のDocker Cacheを利用できるようにする。
# ------------------------------------------------------------

COPY package.json package-lock.json ./

# package-lock.jsonに基づいて依存ライブラリをインストール
RUN npm ci


# ------------------------------------------------------------
# Frontendソースコードをコピー
# ------------------------------------------------------------

COPY . .


# ------------------------------------------------------------
# Reactアプリケーションを本番用にBuild
#
# Build結果は /app/dist に生成される。
# ------------------------------------------------------------

RUN npm run build


# ============================================================
# Runtime Stage
# nginxを利用してBuild済み静的ファイルを配信する
# ============================================================

FROM nginx:alpine


# ReactのBuild結果をnginx公開ディレクトリへコピー
COPY --from=build /app/dist /usr/share/nginx/html


# Novel Archive用nginx設定を配置
#
# React画面の配信に加えて、
# /api/* をBackendへReverse Proxyする。
COPY nginx.conf /etc/nginx/conf.d/default.conf


# nginxの待受ポート
EXPOSE 80